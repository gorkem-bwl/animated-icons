  "animationTypes": {
    "directional": {
      "description": "Elements translate in the direction the icon suggests",
      "css": "translateX or translateY with slight overshoot"
    },
    "pop-envelope": {
      "description": "Container stays, content pops up or opens",
      "css": "scale + translateY on inner elements"
    },
    "playback": {
      "description": "Play/pause style transforms, scale bounce",
      "css": "scale from center with slight bounce"
    },
    "unfold": {
      "description": "Page unfold or reveal effect",
      "css": "scaleY from top edge, opacity cascade"
    },
    "toggle": {
      "description": "Quick snap/toggle transformation",
      "css": "scale bounce with slight rotation"
    },
    "pulse": {
      "description": "Pulsing or breathing effect",
      "css": "scale pulse with opacity"
    },
    "ambient": {
      "description": "Gentle ambient motion (floating, swaying)",
      "css": "subtle translateY + rotation loop"
    },
    "bounce-in": {
      "description": "Bounce in from bottom or side",
      "css": "translateY with spring easing"
    },
    "draw": {
      "description": "Stroke draw-in effect",
      "css": "stroke-dashoffset animation"
    },
    "wave": {
      "description": "Wave or greeting animation",
      "css": "rotation with transform-origin shift"
    },
    "locate": {
      "description": "Pin drop or locate pulse",
      "css": "translateY drop + scale ring pulse"
    },
    "chart-rise": {
      "description": "Bars/lines rising up",
      "css": "scaleY from bottom with stagger"
    },
    "shield": {
      "description": "Shield solidify/lock effect",
      "css": "scale with inner element draw-in"
    },
    "type-in": {
      "description": "Characters typing in",
      "css": "stroke-dashoffset with stagger per element"
    }
  }
}
